"""FreeCADCmd launcher for the current five-case FieldCraft STEP oracle."""
import os
from pathlib import Path
import runpy
import sys

macro_path = Path(__file__).resolve()
root = macro_path.parents[2]
script = root / "tests/references/fieldcraft_compact_model_oracle.py"
args = []
for env_name, option in (
    ("FIELDCRAFT_CLI", "--cli"),
    ("FIELDCRAFT_WORK", "--work"),
    ("FIELDCRAFT_CURRENT_DIR", "--current-dir"),
    ("FIELDCRAFT_SOURCE_DIR", "--source-dir"),
    ("FIELDCRAFT_HOST_DIR", "--host-dir"),
    ("FIELDCRAFT_OCC_VOLUME", "--occ-volume"),
    ("FIELDCRAFT_OUTPUT", "--output"),
):
    value = os.environ.get(env_name)
    if value:
        args.extend((option, value))
for case in os.environ.get("FIELDCRAFT_CASES", "").split(","):
    if case:
        args.extend(("--case", case))
if os.environ.get("FIELDCRAFT_FAST") == "1":
    args.append("--fast")
sys.argv = [str(script), *args]
runpy.run_path(str(script), run_name="__main__")
