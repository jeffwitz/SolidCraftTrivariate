{
  "id": "solidcraft-trivariate",
  "name": "SolidCraft Trivariate",
  "version": "0.4.1",
  "description": "Builds and displays audited SolidCraft Trivariate sketch, recipe and preview geometry using SolidCraft native features.",
  "capabilities": [
    "commands@0.2"
  ],
  "runtime": {
    "module": "solidcraft-trivariate.wasm",
    "commands": [
      "timeline.export_script",
      "timeline.add",
      "browser.visibility",
      "view.visual_style",
      "timeline.edit",
      "timeline.suppress",
      "model.body_features",
      "model.faces",
      "solid.remove",
      "solid.combine",
      "inspect.measure",
      "model.edges",
      "inspect.classify_points",
      "solid.fillet",
      "solid.chamfer",
      "sketch.create",
      "sketch.line",
      "sketch.arc.center_point",
      "sketch.finish",
      "solid.extrude",
      "timeline.delete"
    ],
    "entries": [
      {
        "name": "extrude-active-sketch",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "properties": {
            "source_feature_id": {
              "type": "integer",
              "title": "Sketch feature id",
              "default": 1,
              "minimum": 1
            },
            "height_mm": {
              "type": "integer",
              "title": "Extrusion height (mm)",
              "default": 12,
              "minimum": 1,
              "maximum": 64
            }
          },
          "x-solidcraft-icon": "icons/extrude.svg"
        }
      },
      {
        "name": "extrude-active-timeline",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "build-recipe",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "properties": {
            "recipe": {
              "type": "string",
              "title": "Recipe file",
              "default": "recipe.json"
            },
            "rim": {
              "type": "string",
              "title": "Bore rim",
              "enum": [
                "sharp",
                "chamfer",
                "fillet"
              ],
              "default": "sharp"
            },
            "operation": {
              "type": "string",
              "title": "Boolean operation",
              "enum": [
                "from_recipe",
                "union",
                "intersection",
                "a_minus_b",
                "b_minus_a"
              ],
              "default": "from_recipe"
            }
          }
        }
      },
      {
        "name": "insert-result",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "snapshot-timeline",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "show-sketch-stage",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "properties": {
            "descriptor": {
              "type": "string",
              "title": "Descriptor file",
              "default": "partition.json"
            },
            "source_feature_id": {
              "type": "integer",
              "title": "Source sketch feature id",
              "default": 1,
              "minimum": 1
            }
          }
        }
      },
      {
        "name": "hide-sketch-stage",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "properties": {
            "descriptor": {
              "type": "string",
              "title": "Descriptor file",
              "default": "partition.json"
            },
            "source_feature_id": {
              "type": "integer",
              "title": "Source sketch feature id",
              "default": 1,
              "minimum": 1
            }
          }
        }
      },
      {
        "name": "drill",
        "effect": "edit",
        "slots": [
          {
            "kind": "ribbon",
            "name": "Sketch"
          }
        ],
        "input_schema": {
          "type": "object",
          "properties": {
            "target_body": {
              "type": "array",
              "title": "Target body",
              "maxItems": 1,
              "x-solidcraft-selection": {
                "version": 1,
                "accept": [
                  "body"
                ]
              }
            },
            "radius_mm": {
              "type": "integer",
              "title": "Centered bore radius (mm)",
              "default": 5,
              "minimum": 1
            },
            "source_feature_id": {
              "type": "integer",
              "title": "Source rectangle sketch (0 for reference box)",
              "default": 0,
              "minimum": 0
            },
            "height_mm": {
              "type": "integer",
              "title": "Source extrusion height (mm)",
              "default": 12,
              "minimum": 1
            }
          },
          "x-solidcraft-icon": "icons/drill.svg"
        }
      },
      {
        "name": "boolean",
        "effect": "edit",
        "slots": [
          {
            "kind": "ribbon",
            "name": "Sketch"
          }
        ],
        "input_schema": {
          "type": "object",
          "properties": {
            "target_body": {
              "type": "array",
              "title": "Target body",
              "maxItems": 1,
              "x-solidcraft-selection": {
                "version": 1,
                "accept": [
                  "body"
                ]
              }
            },
            "operation": {
              "type": "string",
              "title": "Operation",
              "enum": [
                "union",
                "intersection",
                "a_minus_b",
                "b_minus_a"
              ],
              "default": "union"
            },
            "tool_body": {
              "type": "array",
              "title": "Cylinder tool",
              "maxItems": 1,
              "x-solidcraft-selection": {
                "version": 1,
                "accept": [
                  "body"
                ]
              }
            }
          },
          "x-solidcraft-icon": "icons/boolean.svg"
        }
      },
      {
        "name": "chamfer",
        "effect": "edit",
        "slots": [
          {
            "kind": "ribbon",
            "name": "Sketch"
          }
        ],
        "input_schema": {
          "type": "object",
          "properties": {
            "selection": {
              "type": "array",
              "title": "Edges or boundary of a face",
              "description": "Pick on the finished solid in the viewport. Uses SolidCraft B-rep edge treatment.",
              "minItems": 1,
              "x-solidcraft-selection": {
                "version": 1,
                "accept": [
                  "edge",
                  "face"
                ]
              }
            },
            "distance_mm": {
              "type": "number",
              "title": "Distance (mm)",
              "default": 0.25,
              "exclusiveMinimum": 0
            }
          },
          "x-solidcraft-icon": "icons/chamfer.svg",
          "required": [
            "selection"
          ]
        }
      },
      {
        "name": "fillet",
        "effect": "edit",
        "slots": [
          {
            "kind": "ribbon",
            "name": "Sketch"
          }
        ],
        "input_schema": {
          "type": "object",
          "properties": {
            "selection": {
              "type": "array",
              "title": "Edges or boundary of a face",
              "description": "Pick on the finished solid in the viewport. Uses SolidCraft B-rep edge treatment.",
              "minItems": 1,
              "x-solidcraft-selection": {
                "version": 1,
                "accept": [
                  "edge",
                  "face"
                ]
              }
            },
            "radius_mm": {
              "type": "number",
              "title": "Radius (mm)",
              "default": 0.25,
              "exclusiveMinimum": 0
            }
          },
          "x-solidcraft-icon": "icons/fillet.svg",
          "required": [
            "selection"
          ]
        }
      },
      {
        "name": "extrude",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "properties": {
            "source_feature_id": {
              "type": "integer",
              "title": "Sketch (0 = latest)",
              "default": 0,
              "minimum": 0
            },
            "height_mm": {
              "type": "number",
              "title": "Depth (mm)",
              "default": 12,
              "minimum": 1e-06,
              "maximum": 4096
            },
            "operation": {
              "type": "string",
              "title": "Material",
              "oneOf": [
                {
                  "const": "auto",
                  "title": "Add on face / new on origin plane"
                },
                {
                  "const": "add",
                  "title": "Add material"
                },
                {
                  "const": "cut",
                  "title": "Remove material"
                },
                {
                  "const": "new",
                  "title": "New body"
                }
              ],
              "default": "auto"
            }
          },
          "x-solidcraft-icon": "icons/extrude.svg"
        },
        "slots": [
          {
            "kind": "ribbon",
            "name": "Sketch"
          }
        ]
      }
    ],
    "permissions": {
      "command_groups": [
        "file"
      ],
      "files": [
        {
          "name": "companion",
          "read": true,
          "write": true
        }
      ]
    },
    "limits": {
      "fuel": 100000000000,
      "memory_mib": 64,
      "deadline_ms": 30000
    }
  }
}
