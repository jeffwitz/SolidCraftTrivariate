{
  "id": "solidcraft-trivariate",
  "name": "SolidCraft Trivariate",
  "version": "0.1.0",
  "description": "Builds and displays audited SolidCraft Trivariate sketch, recipe and preview geometry using SolidCraft native features.",
  "capabilities": ["commands@0.2"],
  "runtime": {
    "module": "solidcraft-trivariate.wasm",
    "commands": ["timeline.export_script", "timeline.add", "browser.visibility", "view.visual_style"],
    "entries": [
      {
        "name": "extrude-active-sketch",
        "effect": "edit",
        "input_schema": {"type": "object", "properties": {
          "source_feature_id": {"type": "integer", "title": "Sketch feature id", "default": 1, "minimum": 1},
          "height_mm": {"type": "integer", "title": "Extrusion height (mm)", "default": 12, "minimum": 1, "maximum": 64}
        }},
        "slots": [{"kind": "ribbon", "name": "Model"}]
      },
      {
        "name": "extrude-active-timeline",
        "effect": "edit",
        "input_schema": {"type": "object", "properties": {}},
        "slots": [{"kind": "ribbon", "name": "Model"}]
      },
      {
        "name": "build-recipe",
        "effect": "edit",
        "input_schema": {"type": "object", "properties": {
          "recipe": {"type": "string", "title": "Recipe file", "default": "recipe.json"},
          "rim": {"type": "string", "title": "Bore rim", "enum": ["sharp", "chamfer", "fillet"], "default": "sharp"},
          "operation": {"type": "string", "title": "Boolean operation", "enum": ["from_recipe", "union", "intersection", "a_minus_b", "b_minus_a"], "default": "from_recipe"}
        }},
        "slots": [{"kind": "ribbon", "name": "Model"}]
      },
      {
        "name": "insert-result",
        "effect": "edit",
        "input_schema": {"type": "object", "properties": {}},
        "slots": [{"kind": "ribbon", "name": "Model"}]
      },
      {
        "name": "snapshot-timeline",
        "effect": "edit",
        "input_schema": {"type": "object", "properties": {}},
        "slots": [{"kind": "ribbon", "name": "Model"}]
      },
      {
        "name": "show-sketch-stage",
        "effect": "edit",
        "input_schema": {"type": "object", "properties": {
          "descriptor": {"type": "string", "title": "Descriptor file", "default": "partition.json"},
          "source_feature_id": {"type": "integer", "title": "Source sketch feature id", "default": 1, "minimum": 1}
        }}
      },
      {
        "name": "hide-sketch-stage",
        "effect": "edit",
        "input_schema": {"type": "object", "properties": {
          "descriptor": {"type": "string", "title": "Descriptor file", "default": "partition.json"},
          "source_feature_id": {"type": "integer", "title": "Source sketch feature id", "default": 1, "minimum": 1}
        }}
      }
    ],
    "permissions": {
      "command_groups": ["file"],
      "files": [{"name": "companion", "read": true, "write": true}]
    },
    "limits": {"fuel": 100000000000, "memory_mib": 64, "deadline_ms": 30000}
  }
}
